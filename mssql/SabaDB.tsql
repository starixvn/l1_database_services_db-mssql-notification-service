CREATE DATABASE [SabaDB]
 CONTAINMENT = NONE
 ON  PRIMARY
( NAME = N'SabaDB', FILENAME = N'/var/opt/mssql/db-mdf/SabaDB.mdf' , SIZE = 8192KB , FILEGROWTH = 8192KB ),
 FILEGROUP [DATA]
( NAME = N'SabaDB_data', FILENAME = N'/var/opt/mssql/db-mdf/SabaDB_data.ndf' , SIZE = 8192KB , FILEGROWTH = 8192KB )
 LOG ON
( NAME = N'SabaDB_log', FILENAME = N'/var/opt/mssql/db-ldf/SabaDB_log.ldf' , SIZE = 8192KB , FILEGROWTH = 8192KB )
 WITH LEDGER = OFF
GO
ALTER DATABASE [SabaDB] SET COMPATIBILITY_LEVEL = 160
GO
ALTER DATABASE [SabaDB] SET ANSI_NULL_DEFAULT OFF
GO
ALTER DATABASE [SabaDB] SET ANSI_NULLS OFF
GO
ALTER DATABASE [SabaDB] SET ANSI_PADDING OFF
GO
ALTER DATABASE [SabaDB] SET ANSI_WARNINGS OFF
GO
ALTER DATABASE [SabaDB] SET ARITHABORT OFF
GO
ALTER DATABASE [SabaDB] SET AUTO_CLOSE OFF
GO
ALTER DATABASE [SabaDB] SET AUTO_SHRINK OFF
GO
ALTER DATABASE [SabaDB] SET AUTO_CREATE_STATISTICS ON(INCREMENTAL = OFF)
GO
ALTER DATABASE [SabaDB] SET AUTO_UPDATE_STATISTICS ON
GO
ALTER DATABASE [SabaDB] SET CURSOR_CLOSE_ON_COMMIT OFF
GO
ALTER DATABASE [SabaDB] SET CURSOR_DEFAULT  GLOBAL
GO
ALTER DATABASE [SabaDB] SET CONCAT_NULL_YIELDS_NULL OFF
GO
ALTER DATABASE [SabaDB] SET NUMERIC_ROUNDABORT OFF
GO
ALTER DATABASE [SabaDB] SET QUOTED_IDENTIFIER OFF
GO
ALTER DATABASE [SabaDB] SET RECURSIVE_TRIGGERS OFF
GO
ALTER DATABASE [SabaDB] SET  DISABLE_BROKER
GO
ALTER DATABASE [SabaDB] SET AUTO_UPDATE_STATISTICS_ASYNC OFF
GO
ALTER DATABASE [SabaDB] SET DATE_CORRELATION_OPTIMIZATION OFF
GO
ALTER DATABASE [SabaDB] SET PARAMETERIZATION SIMPLE
GO
ALTER DATABASE [SabaDB] SET READ_COMMITTED_SNAPSHOT OFF
GO
ALTER DATABASE [SabaDB] SET  READ_WRITE
GO
ALTER DATABASE [SabaDB] SET RECOVERY SIMPLE
GO
ALTER DATABASE [SabaDB] SET  MULTI_USER
GO
ALTER DATABASE [SabaDB] SET PAGE_VERIFY CHECKSUM
GO
ALTER DATABASE [SabaDB] SET TARGET_RECOVERY_TIME = 60 SECONDS
GO
ALTER DATABASE [SabaDB] SET DELAYED_DURABILITY = DISABLED
GO
USE [SabaDB]
GO
ALTER DATABASE SCOPED CONFIGURATION SET LEGACY_CARDINALITY_ESTIMATION = Off;
GO
ALTER DATABASE SCOPED CONFIGURATION FOR SECONDARY SET LEGACY_CARDINALITY_ESTIMATION = Primary;
GO
ALTER DATABASE SCOPED CONFIGURATION SET MAXDOP = 0;
GO
ALTER DATABASE SCOPED CONFIGURATION FOR SECONDARY SET MAXDOP = PRIMARY;
GO
ALTER DATABASE SCOPED CONFIGURATION SET PARAMETER_SNIFFING = On;
GO
ALTER DATABASE SCOPED CONFIGURATION FOR SECONDARY SET PARAMETER_SNIFFING = Primary;
GO
ALTER DATABASE SCOPED CONFIGURATION SET QUERY_OPTIMIZER_HOTFIXES = Off;
GO
ALTER DATABASE SCOPED CONFIGURATION FOR SECONDARY SET QUERY_OPTIMIZER_HOTFIXES = Primary;
GO
USE [SabaDB]
GO
IF NOT EXISTS (SELECT name FROM sys.filegroups WHERE is_default=1 AND name = N'DATA') ALTER DATABASE [SabaDB] MODIFY FILEGROUP [DATA] DEFAULT
GO
