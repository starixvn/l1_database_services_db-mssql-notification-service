USE NotificationDB;

CREATE TYPE dbo.NotiIds AS TABLE (
	NotiId	INT		NOT NULL	PRIMARY KEY NONCLUSTERED
) WITH (MEMORY_OPTIMIZED = ON);

GRANT REFERENCES, EXECUTE ON TYPE::dbo.NotiIds TO app_notifier;

/** 2.0.0 */

CREATE TYPE dbo.NotiResults AS TABLE (
	NotiId	INT		NOT NULL	PRIMARY KEY NONCLUSTERED
,	MessageId	INT		NOT NULL
) WITH (MEMORY_OPTIMIZED = ON);

GRANT REFERENCES, EXECUTE ON TYPE::dbo.NotiResults TO app_notifier;
