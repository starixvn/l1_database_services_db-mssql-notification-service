{
  "name": "db-mssql-notification-service",
  "description": "Fetch messages from MSSQL database then send to Telegram",
  "license": "ISC",
  "type": "module",
  "author": "Billy Bùi <billy.bui@lumiplus.vn> (https://git3.nexdev.net/billy.bui)",
  "contributors": [
    "Billy Bùi <billy.bui@lumiplus.vn> (https://git3.nexdev.net/billy.bui)"
  ],
  "repository": {
    "type": "git",
    "url": "https://git3.nexdev.net/l1/database/services/db-mssql-notification-service.git"
  },
  "scripts": {
    "test:dev": "vitest",
    "test": "vitest run",
    "test-coverage": "vitest run --coverage",
    "build": "rimraf lib && tsc -p tsconfig.prod.json",
    "build:dev": "rimraf lib && tsc",
    "build:cert": "cp certs/* lib/",
    "dev": "pnpm build:dev && pnpm build:cert && node --enable-source-maps lib/index.js"
  },
  "files": [
    "lib/**"
  ],
  "packageManager": "pnpm@9.14.1",
  "dependencies": {
    "@ldb/base-app": "0.1.1",
    "@ldb/base-container": "0.1.1",
    "@ldb/mongo": "6.10.3",
    "@ldb/utils": "0.3.5",
    "https-proxy-agent": "7.0.5",
    "mssql": "11.0.1",
    "node-vault": "0.10.2",
    "telegraf": "4.16.3",
    "undici": "6.20.1"
  },
  "devDependencies": {
    "@commitlint/cli": "19.6.0",
    "@commitlint/config-conventional": "19.6.0",
    "@ldb/eslint-config": "0.2.4",
    "@ldb/logger": "1.1.3",
    "@ldb/prettier-config": "0.1.3",
    "@ldb/scheduler": "0.4.0",
    "@ldb/tsconfig": "22.0.1",
    "@ldb/vitest-config": "0.1.4",
    "@telegraf/types": "7.1.0",
    "@types/mssql": "9.1.5",
    "@types/node": "22.10.0",
    "@vitest/coverage-v8": "2.1.5",
    "eslint": "9.15.0",
    "prettier": "3.3.3",
    "rimraf": "6.0.1",
    "typescript": "5.7.2",
    "vitest": "2.1.5"
  }
}
