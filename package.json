{
  "description": "Fetch messages from MSSQL database then send to Telegram",
  "license": "ISC",
  "type": "module",
  "author": "Billy Bùi",
  "contributors": [
    "Billy Bùi (https://git3.nexdev.net/billy.bui)"
  ],
  "keywords": [
    "mssql",
    "telegram",
    "notification"
  ],
  "repository": {
    "type": "git",
    "url": "https://git3.nexdev.net/l1/database/services/db-mssql-notification-service.git"
  },
  "scripts": {
    "test": "jest --testPathPattern=tests/unit-tests/",
    "test-coverage": "jest --collect-coverage --testPathPattern=tests/unit-tests/",
    "build": "rimraf lib && tsc; cp certs/* lib/",
    "dev": "node lib/index.js"
  },
  "files": [
    "lib/**"
  ],
  "dependencies": {
    "@ldb/logger": "1.0.0",
    "@ldb/scheduler": "3.0.1",
    "@ldb/sentry-logger": "1.0.0",
    "@ldb/skynex-logger": "1.0.0",
    "@ldb/terminal-logger": "1.0.0",
    "@ldb/types": "1.1.0",
    "awilix": "12.0.3",
    "https-proxy-agent": "7.0.5",
    "mssql": "11.0.1",
    "node-vault": "0.10.2",
    "ssl-root-cas": "1.3.1",
    "telegraf": "4.16.3",
    "undici": "6.20.1"
  },
  "devDependencies": {
    "@commitlint/cli": "19.5.0",
    "@commitlint/config-conventional": "19.5.0",
    "@jest/globals": "29.7.0",
    "@ldb/base-logger": "1.0.0",
    "@ldb/eslint-config": "0.1.0",
    "@ldb/prettier-config": "0.1.0",
    "@telegraf/types": "7.1.0",
    "@tsconfig/node20": "^20.1.4",
    "@types/jest": "29.5.14",
    "@types/mssql": "9.1.5",
    "@types/node": "22.8.2",
    "eslint": "9.13.0",
    "jest": "29.7.0",
    "jest-extended": "4.0.2",
    "jest-html-reporters": "3.1.7",
    "jest-junit": "16.0.0",
    "jest-sonar-reporter": "2.0.0",
    "prettier": "3.3.3",
    "rimraf": "6.0.1",
    "ts-jest": "29.2.5",
    "typescript": "5.6.3"
  },
  "jestSonar": {
    "reportPath": "reports",
    "reportFile": "test-reporter.xml",
    "indent": 4
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  }
}
