{
    "license": "ISC",
    "type": "module",
    "scripts": {
        "test": "NODE_OPTIONS=\"--experimental-vm-modules --es-module-specifier-resolution=node --no-warnings\" jest --testPathPattern=tests/unit-tests/",
        "test-coverage": "NODE_OPTIONS=\"--experimental-vm-modules --es-module-specifier-resolution=node --no-warnings\" jest --collect-coverage --testPathPattern=tests/unit-tests/",
        "build": "rimraf lib && tsc; cp certs/* lib/",
        "dev": "NODE_OPTIONS=\"--enable-source-maps --no-warnings --experimental-default-type=module --es-module-specifier-resolution=node\" node lib/index.js"
    },
    "engines": {
        "node": "18"
    },
    "files": [
        "lib/**"
    ],
    "dependencies": {
        "@ldb/logger": "1.0.0",
        "@ldb/scheduler": "^2.0.0",
        "@ldb/sentry-logger": "1.0.0",
        "@ldb/skynex-logger": "1.0.0",
        "@ldb/terminal-logger": "1.0.0",
        "@ldb/types": "^1.0.5",
        "@tsconfig/node18": "^18.2.4",
        "awilix": "^10.0.2",
        "http-proxy-agent": "^7.0.2",
        "mssql": "^11.0.0",
        "node-vault": "^0.10.2",
        "ssl-root-cas": "^1.3.1",
        "telegraf": "^4.16.3"
    },
    "devDependencies": {
        "@commitlint/cli": "^19.3.0",
        "@commitlint/config-conventional": "^19.2.2",
        "@jest/globals": "^29.7.0",
        "@ldb/base-logger": "1.0.0",
        "@telegraf/types": "^7.1.0",
        "@types/jest": "^29.5.12",
        "@types/mssql": "^9.1.5",
        "@types/node": "^20.12.8",
        "eslint": "^8.57.0",
        "eslint-config-google": "^0.14.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-security": "^3.0.0",
        "jest": "^29.7.0",
        "jest-extended": "^4.0.2",
        "jest-html-reporters": "^3.1.7",
        "jest-junit": "^16.0.0",
        "jest-sonar-reporter": "^2.0.0",
        "rimraf": "^5.0.5",
        "ts-jest": "^29.1.2",
        "ts-node": "^10.9.2",
        "typescript": "^5.4.5",
        "typescript-eslint": "^7.8.0"
    },
    "jestSonar": {
        "reportPath": "reports",
        "reportFile": "test-reporter.xml",
        "indent": 4
    },
    "husky": {
        "hooks": {
            "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
        }
    }
}
